includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Teaches PHPStan that a Pest `it()` closure's `$this` is the bound TestCase
    # (Tests\TestCase under tests/Feature via Pest.php). Without it, every
    # `$this->get()` / `->actingAs()` / `->assertDatabaseHas()` inside a closure
    # is "Call to an undefined method Pest\PendingCalls\TestCall::…" — 138 of
    # the 218 errors the first scan of tests/ produced. Listed explicitly because
    # phpstan/extension-installer is not installed, so nothing auto-discovers it.
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    # Retain the explicit worker bootstrap. The Composer types:check command also
    # loads this through --autoload-file, before Larastan constructs its stub extension;
    # bootstrapFiles alone is too late for LARAVEL_VERSION in this installed toolchain.
    bootstrapFiles:
        - vendor/larastan/larastan/bootstrap.php

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 7

services:
    # Types Pest's no-argument `test()` proxy as forwarding to Laravel's
    # TestCase, so `test()->actingAs()` inside a global fixture helper resolves.
    # A type correction, not an ignore — see the class docblock for why this is
    # an extension and not a stub. tests/ is analysed, so this file is too.
    -
        class: Tests\PhpStan\HigherOrderTapProxyMethodsExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
