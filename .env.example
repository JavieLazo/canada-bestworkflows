# ===========================================================================
# BestWorkflows Employee Management System
#
# Template for a LOCAL CLONE and for CI. `composer setup` copies this file to
# .env, then generates an app key and runs `migrate --force` against it.
#
# IT NEVER REACHES PRODUCTION. build-deploy.sh excludes .env.* from both zips,
# and the cPanel host keeps its own .env, which a release never uploads or
# overwrites. New keys reach the operator through the release notes — so every
# key gets a default in config/*.php and an explanation here.
#
# TWO RULES FOR EDITING THIS FILE:
#   * env() is called ONLY inside config/*.php. Nothing in app/, routes/ or
#     database/ may read a variable directly.
#   * "${VAR}" resolves only against lines ABOVE it. A forward reference is
#     left as the literal text "${VAR}" — silently — so never move a line
#     above the one it copies. Single quotes never interpolate at all.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. APPLICATION IDENTITY
#
# The values a dev clone and the host disagree about. The host sets
# APP_ENV=production, APP_DEBUG=false and its own APP_URL in its own .env.
# ---------------------------------------------------------------------------

# Also the browser tab title (resources/views/partials/head.blade.php:5) and
# the mail "from" name.
APP_NAME=BestWorkflows

# Employer shown on reports and current employment records. Each installation
# can set its own company independently of the product name.
# COMPANY_NAME="Example Organization"

APP_ENV=local
APP_DEBUG=true

# Not just link generation: Fortify derives the WebAuthn relying-party id and
# the allowed origin from this (config/fortify.php:146-147), so a wrong scheme
# or host on the server breaks passkey sign-in for everyone.
APP_URL=http://localhost:8000

# LEAVE THIS LINE PRESENT, UNCOMMENTED AND EMPTY. The artisan key generator
# rewrites it by matching /^APP_KEY=/ — commenting or indenting it makes the
# command warn, exit 0 anyway, and leave the app with no encryption key.
#
# APP_KEY is also the fallback HMAC secret behind every passkey user handle
# (config/fortify.php:148). Rotating it signs everyone out, and there is NO
# previous-key fallback for passkeys — every registered one stops working.
# Never regenerate the key on an installation that already has one.
APP_KEY=

# The only escape hatch if APP_KEY ever has to change: old keys still decrypt
# existing 2FA secrets and cookies. It does NOT rescue passkeys.
# APP_PREVIOUS_KEYS=

# THERE IS NO APP_TIMEZONE KNOB. config/app.php:68 hard-codes UTC because
# every timestamp is stored UTC and Manila conversion goes through
# App\Support\ManilaClock alone. Setting APP_TIMEZONE here does nothing.

# The only maintenance driver that works during an outage on a host with no
# shell and no reachable cache.
APP_MAINTENANCE_DRIVER=file

# Laravel's default password work factor. The suites override it to 4, so
# this only ever costs a real sign-in.
BCRYPT_ROUNDS=12

# English-only — the app ships no lang/ directory. Here as the starting point
# if that ever changes.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en


# ---------------------------------------------------------------------------
# 2. DATABASE
#
# CI DEPENDS ON THESE EXACT VALUES. `composer setup` copies this file to .env
# and runs `migrate --force` against the MySQL 8 service in
# .github/workflows/tests.yml, whose MYSQL_DATABASE, port and empty root
# password mirror the six lines below. Change them together.
#
# The suites themselves never use them: phpunit.xml pins sqlite :memory: and
# phpunit.mariadb.xml pins its own disposable MariaDB target.
#
# Production is MariaDB 11.4, and `mysql` is the right driver name for both.
# Dropping the line is NOT harmless: the config default is sqlite, so CI would
# quietly pass against a file instead of a real server.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bestworkflows
DB_USERNAME=root
DB_PASSWORD=

# Stated rather than left to the default, because the schema's row and index
# budgets are written against 4-byte utf8mb4, and because MySQL 8 and MariaDB
# 11.4 do NOT share collation names — utf8mb4_0900_ai_ci exists only on MySQL
# and makes the MariaDB connection fail outright. utf8mb4_unicode_ci is the
# one name valid on both; phpunit.mariadb.xml forces the same pair.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci


# ---------------------------------------------------------------------------
# 3. SESSION AND SIGN-IN
#
# `database` is the only workable driver: the host has no redis or memcached
# daemon, and the nightly prune in routes/console.php works on the sessions
# table directly.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database

# Idle minutes before sign-out. Keep it under 1440 — prune-sessions deletes
# any row idle for more than a day regardless of what this says.
SESSION_LIFETIME=120

# Safe at false only because the payload holds nothing but the CSRF token, the
# auth id and flash data. Turning it on signs everyone out once.
SESSION_ENCRYPT=false

SESSION_PATH=/
SESSION_DOMAIN=null

# PINNED ON PURPOSE. Left unset, the cookie is named after APP_NAME
# (config/session.php:130-132), so renaming the app would silently sign every
# user out. Pinning it here breaks that coupling.
SESSION_COOKIE=ems_session

# Set this on the https host. Unset, the Secure flag is only added when the
# request itself looks secure, which fails behind a TLS-terminating proxy.
# SESSION_SECURE_COOKIE=true

# Seconds a password confirmation keeps 2FA and passkey management unlocked
# (Laravel's default, 3 hours). Listed because it is otherwise invisible.
# AUTH_PASSWORD_TIMEOUT=10800


# ---------------------------------------------------------------------------
# 4. CACHE, QUEUE AND FILE STORAGE
#
# Shared cPanel hosting: no shell, no daemon, no worker. Redis, Memcached,
# DynamoDB, SQS, Beanstalkd and S3 are all unreachable, so their keys are
# deliberately absent — Laravel still provides those stores, but nothing here
# can select them.
# ---------------------------------------------------------------------------

# Login throttling and the scheduler's overlap locks go through the default
# cache store, and `database` is the store this repo migrates and prunes.
CACHE_STORE=database

# NOTHING IN THIS APP MAY BE QUEUED — there is no worker to drain a queue (see
# AGENTS.md, "Hosting"). The jobs tables exist from the starter kit, so a job
# dispatched by mistake would sit in `jobs` forever, silently. Side effects run
# inline, or after the response via DB::afterCommit + defer().
QUEUE_CONNECTION=database

# Livewire resolves its temporary upload disk through the default disk, so
# this decides where a picked file lands before the app moves it. `local`
# keeps those bytes under storage/app/private, outside the docroot.
FILESYSTEM_DISK=local


# ---------------------------------------------------------------------------
# 5. REALTIME (BROADCASTING)
#
# OFF BY DEFAULT, AND THAT IS THE WHOLE SWITCH. `null` (like `log`) cannot
# reach a browser, so config/copems.php derives realtime.enabled = false: no
# event is dispatched, no Echo listener is registered, and every screen stays
# on the polls it has always used. Set BROADCAST_CONNECTION=pusher and fill in
# the four PUSHER_* keys to turn it on.
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# ap1 is Pusher's Singapore cluster — the nearest one to Manila. It picks the
# endpoint for both halves, so server and browser must name the same one.
PUSHER_APP_CLUSTER=ap1

# Bounds the outbound call to the broadcaster. The announcement already runs
# after the response is flushed, but an unbounded call would still hold one of
# the host's few PHP processes open through a vendor outage.
# PUSHER_TIMEOUT=5
# PUSHER_CONNECT_TIMEOUT=3

# The browser half. VITE_* IS BAKED INTO public/build BY `npm run build`, not
# read at runtime — so these must be set on the machine that runs
# ./build-deploy.sh, not only on the host. Server keys set without these give
# you a server broadcasting to browsers that are not listening.
#
# These two must stay BELOW the PUSHER_* lines they copy (see the header).
# PUSHER_APP_SECRET is deliberately NOT mirrored: every VITE_* value is
# compiled into a file served to every browser.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Only when the socket server is NOT hosted Pusher — a local Reverb/Soketi
# while verifying, or a VPS later. Unset, both halves talk to Pusher's
# cluster. Note that a scheme of http disables TLS on the socket.
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=8080
# PUSHER_SCHEME=http
# VITE_PUSHER_HOST="${PUSHER_HOST}"
# VITE_PUSHER_PORT="${PUSHER_PORT}"
# VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"


# ---------------------------------------------------------------------------
# 6. MAIL
#
# There is no queue worker, so mail is sent INLINE, inside the request that
# triggered it. That is why the host wants `sendmail`: it hands the message to
# the server's local Exim and opens no network connection, so it cannot hang a
# request the way an unreachable SMTP host can.
# ---------------------------------------------------------------------------

# `log` writes the message to the log instead of sending it — right for a dev
# clone, and silently wrong on the host, where a password-reset mail would
# simply never arrive.
MAIL_MAILER=log

# REPLACE THIS ON THE HOST. cPanel Exim rejects or spam-folders a From on a
# domain the account does not own, which silently kills password resets.
MAIL_FROM_ADDRESS="no-reply@ems.local"
MAIL_FROM_NAME="${APP_NAME}"

# For MAIL_MAILER=sendmail on cPanel. The -bs (or -t) flag is REQUIRED —
# Symfony rejects a bare sendmail path at send time.
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# For MAIL_MAILER=smtp. Read by nothing while the mailer is `log`.
# MAIL_HOST=127.0.0.1
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=smtps

# The SMTP EHLO name. Unset it is derived from APP_URL's host, so a dev or
# misconfigured APP_URL makes outbound mail announce itself as "localhost"
# and get greylisted.
# MAIL_EHLO_DOMAIN=


# ---------------------------------------------------------------------------
# 7. LOGGING
#
# THESE ARE DEV VALUES AND THE HOST DELIBERATELY DISAGREES: it runs
# LOG_LEVEL=error and LOG_STACK=daily. That is why anything an operator must
# be able to find is logged with Log::error — a Log::warning never reaches the
# host log at all.
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack

# `single` is one tailable laravel.log: fine locally, wrong on a shared
# account, where it never rotates and grows against the disk quota.
LOG_STACK=single

# How many daily files are kept — the only bound on log disk use, and so it
# matters on the host, where `daily` is the channel actually in force.
# LOG_DAILY_DAYS=14

LOG_LEVEL=debug

# PHP deprecation notices go to the null handler. Worth knowing: the dev
# machines run PHP 8.5 while the host runs 8.4.
LOG_DEPRECATIONS_CHANNEL=null


# ---------------------------------------------------------------------------
# 8. APPLICATION SETTINGS (config/copems.php)
#
# ALL FIVE STAY COMMENTED. They are listed at their shipped defaults so they
# can be discovered; the defaults live in config/copems.php and the app is
# meant to run on them. `composer setup` copies this file to .env in CI, and
# tests/Feature/UploadLimitsTest.php asserts the upload defaults — so an
# uncommented line carrying any other value fails the suite. An EMPTY value is
# worse than a wrong one: it casts to 0, which rejects every upload.
# ---------------------------------------------------------------------------

# Seconds between eDTR live-feed, "My punches" and open Chat page refreshes
# while realtime is off. The app's largest standing load on a host with few
# PHP processes.
# BESTWORKFLOWS_POLL_FEED=15

# Seconds between those same three polls once a websocket is carrying the news.
# Inert while BROADCAST_CONNECTION=null.
# BESTWORKFLOWS_POLL_BACKSTOP=60

# Per-file upload cap, in bytes (2 MB). The host's own PHP upload_max_filesize
# and post_max_size are a separate, and usually lower, ceiling.
# BESTWORKFLOWS_MAX_UPLOAD_BYTES=2000000

# Attachment budget employee documents and task files share, in bytes (1 GB),
# checked before each of their uploads.
# BESTWORKFLOWS_STORAGE_CEILING_BYTES=1000000000

# Community and Chat's own budget for their photos and files, in bytes
# (500 MB). Separate from the one above: raising either never moves the other,
# and "Community and Chat storage is full" is this one.
# BESTWORKFLOWS_SOCIAL_STORAGE_CEILING_BYTES=500000000
